# .env.internal.local — run the dev app against the LOCAL "real-data" instance
# (the deploy/internal compose stack running on your machine, loaded with the
# migrated Answer Desk data). Copy to `.env.internal.local`.
#
#   npm run dev:internal    # loads this file, then `next dev -p 3001`
#
# Keys = the local stack's ANON_KEY / SERVICE_ROLE_KEY (the official compose
# demo defaults are fine for local). Gitignored (matches .env*.local).
#
# To instead point at the REMOTE production internal server, swap the URLs for
# https://supabase.helpdesk.surveyjs.io / https://helpdesk.surveyjs.io and use
# that instance's real keys — ⚠ that is live production data.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local real-data stack ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<local real-data stack SERVICE_ROLE_KEY>

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
