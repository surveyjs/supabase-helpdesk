# .env.demo.local — run the dev app against the LOCAL "example-data" instance
# (the deploy/showcase compose stack running on your machine, seeded with
# supabase/seed.sql). Copy to `.env.demo.local`.
#
#   npm run dev:demo        # loads this file, then `next dev -p 3002`
#
# Keys = the local stack's ANON_KEY / SERVICE_ROLE_KEY (the official compose
# demo defaults are fine for local). Gitignored (matches .env*.local).
#
# Note the distinct port (8100) so it never collides with the real-data
# instance (8000), and a distinct app port (3002) so both apps can run at once.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:8100
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local example-data stack ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<local example-data stack SERVICE_ROLE_KEY>

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3002
