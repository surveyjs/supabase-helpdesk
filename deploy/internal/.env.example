# ============================================================================
# INTERNAL instance — environment
# Copy to `.env` (same directory) and fill in. NEVER commit the real .env.
# Consumed by BOTH the official Supabase compose and docker-compose.app.yml.
# Reconcile against the official `supabase/docker/.env.example` at the pinned
# version — keys below are the ones that matter for this app; the official file
# has additional knobs (pooler, analytics, etc.) you can keep at defaults.
# ============================================================================

# --- Compose project (keep distinct from the showcase instance) -------------
COMPOSE_PROJECT_NAME=helpdesk-internal

# Absolute path to the repo checkout on this machine (Docker build context).
APP_BUILD_CONTEXT=/opt/helpdesk/src

# --- Postgres ---------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_unique_strong_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Host port the DB is published on (must differ from the showcase instance).
POSTGRES_HOST_PORT=54322

# --- JWT / API keys ---------------------------------------------------------
# Generate a 40+ char random secret, then derive ANON_KEY + SERVICE_ROLE_KEY
# from it (see docs/self-hosting.md → "Generating keys"). Unique per instance.
JWT_SECRET=CHANGE_ME_40_plus_char_random_secret
JWT_EXPIRY=3600
ANON_KEY=CHANGE_ME_anon_jwt
SERVICE_ROLE_KEY=CHANGE_ME_service_role_jwt

# --- Kong gateway (Supabase API entrypoint) ---------------------------------
# Host ports must differ from the showcase instance. Caddy proxies the public
# Supabase domain to KONG_HTTP_PORT.
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# --- Public URLs ------------------------------------------------------------
# Public origin of the Supabase API (what the browser/client bundle calls).
SUPABASE_PUBLIC_URL=https://supabase.helpdesk.surveyjs.io
NEXT_PUBLIC_SUPABASE_URL=https://supabase.helpdesk.surveyjs.io
# Public origin of the Next.js app.
NEXT_PUBLIC_APP_URL=https://helpdesk.surveyjs.io
# Optional override for CSAT email links (defaults to NEXT_PUBLIC_APP_URL).
NEXT_PUBLIC_SITE_URL=

# GoTrue auth: allowed site + redirect URLs (comma-separated for ADDITIONAL_*)
SITE_URL=https://helpdesk.surveyjs.io
ADDITIONAL_REDIRECT_URLS=https://helpdesk.surveyjs.io
API_EXTERNAL_URL=https://supabase.helpdesk.surveyjs.io

# --- Studio (DB admin UI) ---------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION=SurveyJS
STUDIO_DEFAULT_PROJECT=HelpDesk Internal
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_studio_password

# --- App cron / webhook secrets ---------------------------------------------
# Shared secret guarding /api/cron/* and used by pg_cron via app.settings.
CRON_SECRET=CHANGE_ME_openssl_rand_hex_32
# Separate inbound-email webhook secret (falls back to CRON_SECRET if blank).
INBOUND_EMAIL_WEBHOOK_SECRET=

# --- SMTP (auth emails via GoTrue + app notifications via Nodemailer) -------
SMTP_ADMIN_EMAIL=support@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SENDER_NAME=SurveyJS HelpDesk

# --- AI fallback (optional; admin UI + Vault take precedence) ---------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_CUSTOM_ENDPOINT_URL=
