{
  "showQuestionNumbers": "off",
  "pages": [
    {
      "name": "filters",
      "elements": [
        {
          "type": "text",
          "name": "q",
          "title": "Search",
          "inputType": "search",
          "placeholder": "Search title & all posts..."
        },
        {
          "type": "text",
          "name": "email",
          "title": "Submitter Email",
          "placeholder": "email@..."
        },
        {
          "type": "checkbox",
          "name": "status",
          "title": "Status",
          "colCount": 0,
          "minSelectedChoices": 1,
          "choices": [
            { "value": "open", "text": "Open" },
            { "value": "pending", "text": "Pending" },
            { "value": "closed", "text": "Closed" }
          ],
          "defaultValue": ["open", "pending", "closed"]
        },
        {
          "type": "dropdown",
          "name": "sort",
          "title": "Sort By",
          "defaultValue": "updated",
          "allowClear": false,
          "choices": [
            { "value": "updated", "text": "Last Modified" },
            { "value": "updated_asc", "text": "Last Modified (oldest first)" },
            { "value": "activated", "text": "Customer Activity" },
            { "value": "activated_asc", "text": "Customer Activity (oldest first)" },
            { "value": "created", "text": "Created Date" },
            { "value": "sla", "text": "SLA Risk" },
            { "value": "auto", "text": "Auto (Enterprise, priority, recent)" }
          ]
        },
        {
          "type": "dropdown",
          "name": "urgency",
          "title": "Urgency",
          "choices": [
            { "value": "", "text": "All" },
            { "value": "low", "text": "Low" },
            { "value": "medium", "text": "Medium" },
            { "value": "high", "text": "High" },
            { "value": "critical", "text": "Critical" }
          ]
        },
        {
          "type": "dropdown",
          "name": "severity",
          "title": "Severity",
          "startWithNewLine": false,
          "choices": [
            { "value": "", "text": "All" },
            { "value": "low", "text": "Low" },
            { "value": "medium", "text": "Medium" },
            { "value": "high", "text": "High" },
            { "value": "critical", "text": "Critical" }
          ]
        },
        {
          "type": "dropdown",
          "name": "type",
          "title": "Type",
          "choices": [
            { "value": "", "text": "All" }
          ]
        },
        {
          "type": "dropdown",
          "name": "category",
          "title": "Category",
          "startWithNewLine": false,
          "choices": [
            { "value": "", "text": "All" }
          ]
        },
        {
          "type": "dropdown",
          "name": "agent",
          "title": "Assigned Agent",
          "choices": [
            { "value": "", "text": "All" },
            { "value": "unassigned", "text": "Unassigned" }
          ]
        },
        {
          "type": "dropdown",
          "name": "team",
          "title": "Team",
          "startWithNewLine": false,
          "choices": [
            { "value": "", "text": "All" },
            { "value": "none", "text": "No team" }
          ]
        },
        {
          "type": "dropdown",
          "name": "tier",
          "title": "Tier",
          "startWithNewLine": false,
          "choices": [
            { "value": "", "text": "All" },
            { "value": "none", "text": "No tier" }
          ]
        },
        {
          "type": "tagbox",
          "name": "tags",
          "title": "Tags",
          "choices": [],
          "showSelectAllItem": false
        },
        {
          "type": "dropdown",
          "name": "created",
          "title": "Created",
          "choices": [
            { "value": "", "text": "Any time" },
            { "value": "today", "text": "Today" },
            { "value": "yesterday", "text": "Yesterday" },
            { "value": "7d", "text": "Last 7 days" },
            { "value": "30d", "text": "Last 30 days" },
            { "value": "6m", "text": "Last 6 months" },
            { "value": "1y", "text": "Last year" },
            { "value": "custom", "text": "Custom range" }
          ]
        },
        {
          "type": "dropdown",
          "name": "privacy",
          "title": "Visibility",
          "startWithNewLine": false,
          "choices": [
            { "value": "", "text": "All" },
            { "value": "private", "text": "Private" },
            { "value": "public", "text": "Public" }
          ]
        },
        {
          "type": "text",
          "name": "created_from",
          "title": "From",
          "inputType": "date",
          "visibleIf": "{created} = 'custom'"
        },
        {
          "type": "text",
          "name": "created_to",
          "title": "To",
          "inputType": "date",
          "startWithNewLine": false,
          "visibleIf": "{created} = 'custom'"
        }
      ]
    }
  ]
}
