# .env.local — the DEFAULT backend for `npm run dev` and `npm run build`/`start`.
#
# ── Which env file does what (local development) ────────────────────────────
#   File                      Script              Backend
#   .env.test (committed)     npm run dev:local   local `supabase start` Docker
#   .env.demo.local           npm run dev:demo    self-hosted DEMO (helpdesk.demos…)
#   .env.internal.local       npm run dev:internal real INTERNAL (helpdesk.surveyjs…)  ⚠ prod data
#   .env.local (this file)    npm run dev         whatever you set here (your default)
#
#   - `.env.test` is committed with deterministic local-container keys — used by
#     vitest (db tests) and playwright (e2e). Never put real secrets in it.
#   - `.env.demo.local` / `.env.internal.local` are gitignored; copy them from
#     the matching `*.example` files. See docs/self-hosting.md → "Local env files".
#   - For a safe default, point THIS file at the local container (same values as
#     .env.test) so a bare `npm run dev` never touches a remote/real database.
#   - Do NOT point this at Supabase Cloud (being decommissioned — see
#     docs/self-hosting.md → "Decommissioning Vercel + Supabase Cloud").

# --- Supabase project (REQUIRED) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App URLs (REQUIRED for emails / password reset / inbound links) -----
# Public origin of the running Next.js app. Used by auth emails, the inbound
# email parser, and admin pages that build absolute URLs.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
# Optional — overrides NEXT_PUBLIC_APP_URL specifically for CSAT email links.
# NEXT_PUBLIC_SITE_URL=

# --- AI / LLM (optional env-level fallback) ----------------------------------
# Used when no API key is configured in Admin → AI. If a key is later saved
# through the admin UI it is stored in Supabase Vault and takes precedence.
# AI_PROVIDER=openai             # openai | anthropic | custom
# AI_API_KEY=                    # provider API key
# AI_MODEL=                      # model name, e.g. gpt-4o or claude-3-5-sonnet-20241022
# AI_CUSTOM_ENDPOINT_URL=        # only when AI_PROVIDER=custom

# --- Cron / webhook secrets (REQUIRED in production) ---------------------
# Shared secret for the SLA + notifications cron endpoints. If unset, the
# routes fall back to SUPABASE_SERVICE_ROLE_KEY (acceptable in dev only).
# Generate a random 32+ char token, e.g.: openssl rand -hex 32
CRON_SECRET=
# Optional — separate secret for the inbound-email webhook. Falls back to
# CRON_SECRET when unset.
# INBOUND_EMAIL_WEBHOOK_SECRET=
