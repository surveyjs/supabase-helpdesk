# ============================================================================
# SHOWCASE instance — environment (public demo, NO real customer data)
# Copy to `.env`. Ports/keys MUST differ from the internal instance.
# ============================================================================

COMPOSE_PROJECT_NAME=helpdesk-showcase

# Absolute path to the repo checkout on the demos machine (Docker build context).
APP_BUILD_CONTEXT=/opt/demos/helpdesk/src

# --- Postgres ---------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_unique_strong_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Distinct host port from the internal instance (internal uses 54322).
POSTGRES_HOST_PORT=54323

# --- JWT / API keys (unique per instance) -----------------------------------
JWT_SECRET=CHANGE_ME_40_plus_char_random_secret
JWT_EXPIRY=3600
ANON_KEY=CHANGE_ME_anon_jwt
SERVICE_ROLE_KEY=CHANGE_ME_service_role_jwt

# --- Kong gateway -----------------------------------------------------------
# Required by the official compose. Traefik routes to kong over the docker
# network (not these host ports), but the official compose still binds them —
# pick values that don't clash with other examples on the demos machine. You
# may firewall/ignore them since public traffic comes through Traefik.
KONG_HTTP_PORT=8100
KONG_HTTPS_PORT=8543

# --- Traefik integration (match the demos host's Traefik install) -----------
# External docker network Traefik watches (must already exist on the host).
TRAEFIK_NETWORK=traefik
# TLS entrypoint + ACME certresolver names as configured in that Traefik.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le

# --- Public URLs ------------------------------------------------------------
# Bare hostnames used by the Traefik Host() router rules. Must correspond to
# the *_URL values below (host part, no scheme).
APP_PUBLIC_HOST=helpdesk.demos.surveyjs.io
SUPABASE_PUBLIC_HOST=supabase.helpdesk.demos.surveyjs.io

SUPABASE_PUBLIC_URL=https://supabase.helpdesk.demos.surveyjs.io
NEXT_PUBLIC_SUPABASE_URL=https://supabase.helpdesk.demos.surveyjs.io
NEXT_PUBLIC_APP_URL=https://helpdesk.demos.surveyjs.io
NEXT_PUBLIC_SITE_URL=

SITE_URL=https://helpdesk.demos.surveyjs.io
ADDITIONAL_REDIRECT_URLS=https://helpdesk.demos.surveyjs.io
API_EXTERNAL_URL=https://supabase.helpdesk.demos.surveyjs.io

# --- Studio -----------------------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION=SurveyJS
STUDIO_DEFAULT_PROJECT=HelpDesk Demo
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_studio_password

# --- App cron / webhook secrets ---------------------------------------------
CRON_SECRET=CHANGE_ME_openssl_rand_hex_32
INBOUND_EMAIL_WEBHOOK_SECRET=

# --- SMTP -------------------------------------------------------------------
SMTP_ADMIN_EMAIL=demo@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SENDER_NAME=SurveyJS HelpDesk Demo

# --- AI fallback (optional) -------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_CUSTOM_ENDPOINT_URL=
