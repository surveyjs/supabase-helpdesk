# ============================================================================
# Caddy proxy environment (dedicated helpdesk machine). Copy to `.env`.
# Consumed by docker-compose.yml and substituted into the Caddyfile via {$VAR}.
# Same Caddyfile everywhere — only these values change per machine.
# ============================================================================

# Let's Encrypt registration email.
ACME_EMAIL=admin@surveyjs.io

# Public hostnames Caddy serves (bare host, no scheme).
APP_PUBLIC_HOST=helpdesk.surveyjs.io
SUPABASE_PUBLIC_HOST=supabase.helpdesk.surveyjs.io
DEPLOY_PUBLIC_HOST=deploy.helpdesk.surveyjs.io
